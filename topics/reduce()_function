# reduce() function usi ng lambda function
from functools import reduce
a = [1, 2, 3]
res = reduce(lambda x, y: x + y, a, 10)
print(res)  # Output: 16

# reduce() function with operator module
import functools
import operator
a = [1, 3, 5, 6, 2]
print(functools.reduce(operator.add, a))  # Output: 17
print(functools.reduce(operator.mul, a))  # Output: 180
print(functools.reduce(operator.sub, a))  # Output: -15
