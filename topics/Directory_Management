import os
total_size = 0
for dirpath, dirnames, filenames in os.walk(os.getcwd()):
    for f in filenames:
        fp = os.path.join(dirpath, f)
        total_size += os.path.getsize(fp)

print("Total directory size:", total_size, "bytes")


