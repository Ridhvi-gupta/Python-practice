# Also known as nested functions, inner functions are defined within another function. They can access variables from the outer function's scope. Here's an example:
def fun1(msg):  # outer function
    def fun2():  # inner function
        print(msg)  # access variable from outer scope
    fun2()
fun1("Hello")

def fun1(): 
    a = 45
    def fun2(): 
        nonlocal a 
        a=54
        print(a)
    fun2()
    print(a)
fun1()

def process_data(data):
    def clean_data():
        return [item.strip() for item in data] 
    return clean_data()
print(process_data(["  Python  ", "  Inner Function  "]))