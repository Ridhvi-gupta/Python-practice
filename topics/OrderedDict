# OrderedDict is a subclass of Python’s built-in dictionary that remembers the order in which keys are inserted. 
from collections import OrderedDict

od = OrderedDict()
od['apple'] = 1
od['banana'] = 2
od['cherry'] = 3

print(list(od.items())) # Output : [('apple', 1), ('banana', 2), ('cherry', 3)]\


from collections import OrderedDict

print("dict")
d = {}
d['a'] = 1
d['b'] = 2
d['c'] = 3
d['d'] = 4
for key, val in d.items():
    print(key, val)
    # Output may vary in order, e.g., a 1, b 2, c 3, d 4 (order not guaranteed)


print("ordered dict")
od = OrderedDict()
od['d'] = 4
od['b'] = 2
od['a'] = 1
od['c'] = 3
for key, val in od.items():
    print(key, val)
    # Output: d 4, b 2, a 1, c 3 (order is preserved as inserted)


from collections import OrderedDict

d = {'a': 1, 'b': 2, 'c': 3}
for k, v in d.items():
    print(k, v)
    # Output may vary in order, e.g., a 1, b 2, c 3 (order not guaranteed)


print("OrderedDict:")
od = OrderedDict([('d', 4), ('b', 2), ('a', 1), ('c', 3)])
for k, v in od.items():
    print(k, v)
    # Output: d 4, b 2, a 1, c 3 (order is preserved as inserted)


