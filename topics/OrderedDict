from collections import OrderedDict

d1 = OrderedDict([('a', 1), ('b', 2), ('c', 3)])
d2 = OrderedDict(reversed(list(d1.items())))

for k, v in d2.items():
    print(k, v) # Output : c 3, b 2, a 1


from collections import OrderedDict
d = OrderedDict([('a', 1), ('b', 2), ('c', 3)])

res = d.popitem(last=True)  # Remove last inserted item
print(res)
# Output: ('c', 3)

from collections import OrderedDict
d = OrderedDict([('a', 1), ('b', 2), ('c', 3)])

d.move_to_end('a')         # Move 'a' to end
d.move_to_end('b', last=False)  # Move 'b' to front

for k, v in d.items():
    print(k, v)
# Output:
# b 2
# a 1
# c 3


from collections import OrderedDict
od = OrderedDict([('a', 1), ('b', 2), ('c', 3), ('d', 4)])
od.pop('c')    # Delete 'c'

for k, v in od.items():
    print(k, v) 
    # Output:
# a 1   
# b 2
# d 4       
# a 1
# b 2
# d 4
# c 3

od['c'] = 3    # Re-insert 'c' at end
for k, v in od.items():
    print(k, v)
 # Output: 
# a 1
# b 2
# d 4
# a 1
# b 2
# d 4
# c 3

